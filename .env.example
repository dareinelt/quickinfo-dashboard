# Kopieren nach .env und Werte anpassen:  cp .env.example .env
# Alle Variablen sind optional – ohne .env gelten die Standardwerte aus docker-compose.yml.

# Webport des Management-Boards auf dem Host
HTTP_PORT=8080

# Datenbank (MariaDB)
DB_NAME=qiboard
DB_USER=qiboard
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# Geheimer Schlüssel zur Verschlüsselung der Node-API-Keys (AES-256-GCM).
# Unbedingt ändern, z.B.:  openssl rand -hex 32
# Achtung: Bei Änderung nach dem ersten Start sind bereits gespeicherte API-Keys nicht mehr lesbar.
APP_SECRET=change-me-app-secret-please

# Erster Admin-Benutzer (wird nur angelegt, wenn noch kein Benutzer existiert)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Session-Laufzeit in Sekunden (Standard 12h)
SESSION_LIFETIME=43200

# Collector: Abfrageintervall in Sekunden (30–60 empfohlen) und HTTP-Timeout pro Node
COLLECTOR_INTERVAL=60
COLLECTOR_TIMEOUT=10

# Datenhaltung: Rohdaten (Tage) und 10-Minuten-Aggregate (Tage)
RETENTION_RAW_DAYS=4
RETENTION_AGG_DAYS=30

TZ=Europe/Berlin
